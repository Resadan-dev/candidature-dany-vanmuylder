# Copy to .env, or let bench.sh / bench.ps1 generate it with random
# passwords. Local bench only: none of this leaves the machine, the ports
# are published on 127.0.0.1 exclusively.
#
# SQL Server requires a strong password: 8 characters minimum, with upper
# case, lower case, digits and symbols.

MSSQL_SA_PASSWORD=change-me-Aa1!
SQL_READONLY_PASSWORD=change-me-Bb2!
