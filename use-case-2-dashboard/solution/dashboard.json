    {
      "id": 1,
      "type": "stat",
      "title": "",
      "description": "Bannière de fraîcheur, portée par SQL (survit à une API morte comme à une API vivante servant des données figées). Calcul entièrement côté serveur.",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "mssql", "uid": "${DS_BHS_SQL}" },
      "interval": "1m",
      "pluginVersion": "9.5.15",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mssql", "uid": "${DS_BHS_SQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last_insert AS (\n    SELECT TOP 1 created_at FROM bag_tracking ORDER BY id DESC\n),\nactive AS (\n    SELECT COUNT(*) AS n FROM (\n        SELECT status, ROW_NUMBER() OVER (PARTITION BY tag_id ORDER BY timestamp DESC, id DESC) AS rn\n        FROM bag_tracking\n        WHERE timestamp > DATEADD(HOUR, -6, GETUTCDATE())\n    ) t\n    WHERE rn = 1 AND status = 'IN_SYSTEM'\n)\nSELECT CASE\n           WHEN DATEDIFF(MINUTE, li.created_at, GETDATE()) <= 5 THEN 'OK'\n           WHEN a.n = 0 THEN 'IDLE'\n           ELSE 'STALE'\n       END AS freshness\nFROM last_insert li CROSS JOIN active a;"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^freshness$/",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": { "valueSize": 48 }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "OK": { "text": "DONNÉES À JOUR", "color": "green", "index": 0 },
                "IDLE": { "text": "SYSTÈME AU REPOS : AUCUN BAGAGE ATTENDU", "color": "blue", "index": 1 },
                "STALE": { "text": "DATA STALE : DONNÉES FIGÉES DEPUIS PLUS DE 5 MIN", "color": "red", "index": 2 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "noValue": "DATA STALE : SQL INJOIGNABLE"
        },
        "overrides": []
      }
    },
