    {
      "id": 4,
      "type": "stat",
      "title": "Santé des données",
      "description": "Fantômes probables : bagages IN_SYSTEM sans scan depuis plus de 6 h (bug tracker, use case 1). L'écart API - SQL rend la divergence visible au lieu de la masquer.",
      "gridPos": { "h": 6, "w": 6, "x": 14, "y": 3 },
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "interval": "1m",
      "pluginVersion": "9.5.15",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mssql", "uid": "${DS_BHS_SQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last_state AS (\n    SELECT tag_id, timestamp AS last_seen, status,\n           ROW_NUMBER() OVER (PARTITION BY tag_id ORDER BY timestamp DESC, id DESC) AS rn\n    FROM bag_tracking\n)\nSELECT COUNT(*) AS probable_phantoms\nFROM last_state\nWHERE rn = 1 AND status = 'IN_SYSTEM'\n  AND last_seen <= DATEADD(HOUR, -6, GETUTCDATE());"
        },
        {
          "refId": "B",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_BHS_API}" },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://api.nce-bhs.local:8080/api/v1/status",
          "url_options": { "method": "GET", "data": "" },
          "root_selector": "",
          "columns": [
            { "selector": "bags_in_system", "text": "bags_in_system_api", "type": "number" }
          ],
          "filters": [],
          "global_query_id": ""
        },
        {
          "refId": "C",
          "datasource": { "type": "mssql", "uid": "${DS_BHS_SQL}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last_state AS (\n    SELECT tag_id, timestamp AS last_seen, status,\n           ROW_NUMBER() OVER (PARTITION BY tag_id ORDER BY timestamp DESC, id DESC) AS rn\n    FROM bag_tracking\n)\nSELECT COUNT(*) AS bags_in_system_sql\nFROM last_state\nWHERE rn = 1 AND status = 'IN_SYSTEM'\n  AND last_seen > DATEADD(HOUR, -6, GETUTCDATE());"
        },
        {
          "refId": "D",
          "datasource": { "type": "__expr__", "uid": "__expr__" },
          "type": "math",
          "expression": "$B - $C",
          "hide": false
        }
      ],
      "transformations": [
        {
          "id": "filterByRefId",
          "options": { "include": "A|D" }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
